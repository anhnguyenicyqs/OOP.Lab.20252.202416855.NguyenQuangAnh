<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="768.0" prefWidth="1024.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1">

    <!-- TOP: Cart header -->
    <top>
        <HBox prefHeight="100.0">
            <BorderPane.margin>
                <Insets left="20.0" right="20.0"/>
            </BorderPane.margin>
            <Label style="-fx-font-size: 50px; -fx-text-fill: #004cff;" text="Cart"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#btnViewStorePressed" prefHeight="50.0" prefWidth="100.0" text="View Store"/>
        </HBox>
    </top>

    <!-- CENTER: Filter + TableView + action buttons -->
    <center>
        <VBox>
            <BorderPane.margin>
                <Insets left="20.0" right="20.0"/>
            </BorderPane.margin>

            <!-- Filter row -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <padding>
                    <Insets bottom="10.0" top="10.0"/>
                </padding>
                <Label text="Filter:"/>
                <TextField fx:id="tfFilter"/>
                <fx:define>
                    <ToggleGroup fx:id="filterCategory"/>
                </fx:define>
                <RadioButton fx:id="radioBtnFilterId" selected="true"
                             text="By ID" toggleGroup="$filterCategory"/>
                <RadioButton fx:id="radioBtnFilterTitle"
                             text="By Title" toggleGroup="$filterCategory"/>
            </HBox>

            <!-- TableView -->
            <TableView fx:id="tblMedia" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colMediaId" text="ID"/>
                    <TableColumn fx:id="colMediaTitle" text="Title"/>
                    <TableColumn fx:id="colMediaCategory" text="Category"/>
                    <TableColumn fx:id="colMediaCost" text="Cost"/>
                </columns>
            </TableView>

            <!-- Play / Remove buttons -->
            <HBox alignment="TOP_RIGHT" spacing="20.0">
                <padding>
                    <Insets top="10.0"/>
                </padding>
                <Button fx:id="btnPlay" onAction="#btnPlayPressed"
                        prefWidth="60.0" text="Play"/>
                <Button fx:id="btnRemove" onAction="#btnRemovePressed"
                        prefWidth="60.0" text="Remove"/>
            </HBox>
        </VBox>
    </center>

    <!-- BOTTOM: Total + Place Order -->
    <bottom>
        <VBox alignment="TOP_CENTER" prefHeight="200.0" spacing="30.0">
            <HBox alignment="CENTER" spacing="10.0">
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Total:"/>
                <Label fx:id="costLabel" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="0 $"/>
            </HBox>
            <Button onAction="#btnPlaceOrderPressed"
                    style="-fx-background-color: #004cff; -fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"
                    text="Place Order"/>
        </VBox>
    </bottom>
</BorderPane>
